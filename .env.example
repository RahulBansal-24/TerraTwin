# TerraTwin Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional LLM API Keys (for enhanced scientific narrative synthesis)
